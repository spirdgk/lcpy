  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:55.290465Z",
     "start_time": "2025-06-12T10:06:55.276965Z"
    }
   },
   "cell_type": "code",
   "source": [
    "amount_of_butanol = np.random.uniform(low=12. , high=14., size=(scenarios, timeframe//time_step))\n",
    "amount_of_wastewater = np.random.uniform(low=1. , high=3., size=(scenarios, timeframe//time_step))*(-1)\n",
    "functional_unit = amount_of_butanol + amount_of_wastewater"
   ],
   "id": "c9df30deef0c2577",
   "outputs": [],
   "execution_count": 26
  },
  {
   "metadata": {
    "ExecuteTime": {
