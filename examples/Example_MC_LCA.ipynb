   },
   "cell_type": "code",
   "source": [
    "from lcpy.calculators.bw_int import mpLCAer\n",
    "import os\n",
    "from lcpy.hvs.hvs import store_scenario_results\n",
    "from lcpy.calculators.env_calc import fast_calculator\n",
    "import pandas as pd\n",
    "from lcpy.hvs.map_dicts import create_mapping, create_list_with_unique_activities\n",
    "import numpy as np"
   ],
   "id": "b9492f93e3aa4621",
   "outputs": [],
   "execution_count": 1
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "The initial configuration remains the same with the simple LCA example",
   "id": "2a73b0b24df11c99"
  },
  {
  "metadata": {},
  "cell_type": "markdown",
  "source": "This workbook can work directly in the environment defined in the end_to_end_tutorial if the user installs lcpy and brightway in the same environment. The user can set the same bw environment with:",
  "id": "fdfdg"
  },
  {
  "metadata": {},
  "cell_type": "code",
  "source": [
    "import bw2data as bd\n",
    
   ],
   "id": "sfgdfhdfgj",
   "outputs": [],
   "execution_count": 0
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.476032Z",
     "start_time": "2025-06-12T10:06:21.468078Z"
    }
   },
   "cell_type": "code",
   "source": [
    "target_dir = \"path_of_directory_where_to_store_results\"\n",
    "os.makedirs(target_dir, exist_ok=True)"
   ],
   "id": "34e4809cf8b52165",
   "outputs": [],
   "execution_count": 2
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.730509Z",
     "start_time": "2025-06-12T10:06:21.715705Z"
    }
   },
   "cell_type": "code",
   "source": [
    "brightway_configuration_dictionary = {\n",
    "    \"path_to_brightway_project\": \"path_to_folder_containing_the_bw_environment_and_packages_installed_there\",\n",
    "    \"bw_project\": \"bw_project_name\",\n",
    "    \"bw_database\": \"bw_project_database_name\",\n",
    "    \"bw_biosphere\": \"bw_project_biosphere_database_name\",\n",
    "    \"bw_ecoinvent\": \"ecoinvent_database_used_name\"\n",
    "}"
   ],
   "id": "299cfc96d267c1d9",
   "outputs": [],
   "execution_count": 3
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.761740Z",
     "start_time": "2025-06-12T10:06:21.748690Z"
    }
   },
   "cell_type": "code",
   "source": [
    "methods_list = [\n",
    "('TRACI v2.1', 'acidification', 'acidification potential (AP)'),\n",
    "('TRACI v2.1', 'climate change', 'global warming potential (GWP100)'),\n",
    "('TRACI v2.1', 'ecotoxicity: freshwater', 'ecotoxicity: freshwater'),\n",
    "('TRACI v2.1', 'eutrophication', 'eutrophication potential'),\n",
    "('TRACI v2.1', 'human toxicity: carcinogenic', 'human toxicity: carcinogenic'),\n",
    "('TRACI v2.1', 'human toxicity: non-carcinogenic', 'human toxicity: non-carcinogenic'),\n",
    "('TRACI v2.1', 'ozone depletion', 'ozone depletion potential (ODP)'),\n",
    "('TRACI v2.1', 'particulate matter formation', 'particulate matter formation potential (PMFP)'),\n",
    "('TRACI v2.1', 'photochemical oxidant formation', 'maximum incremental reactivity (MIR)'),\n",
    "]\n",
    "\n",
    "method_units_list = ['kg SO2-Eq',\n",
    " 'kg CO2-Eq',\n",
    " 'CTUe',\n",
    " 'kg N-Eq',\n",
    " 'CTUh',\n",
    " 'CTUh',\n",
    " 'kg CFC-11-Eq',\n",
    " 'kg PM2.5-Eq',\n",
    " 'kg O3-Eq',\n",
    "]"
   ],
   "id": "f6d9d3f751169b91",
   "outputs": [],
   "execution_count": 4
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.793183Z",
     "start_time": "2025-06-12T10:06:21.780359Z"
    }
   },
   "cell_type": "code",
   "source": [
    "methods_gp = methods_list[:]\n",
    "impact_categories_names = ['AP', 'GWP100', 'ECFW', 'EP', 'HTC', 'HTNC', 'ODP', 'PMFP', 'MIR']"
   ],
   "id": "8a3a386b4df36060",
   "outputs": [],
   "execution_count": 5
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "In contrast to the simple LCA we now set the number of scenarios to a high number that basically represents the MC loops",
   "id": "b1a70232af471273"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.830527Z",
     "start_time": "2025-06-12T10:06:21.811584Z"
    }
   },
   "cell_type": "code",
   "source": [
    "scenarios = 30000\n",
    "timeframe = 1 #operational lifetime after construction\n",
    "time_step = 1\n",
    "construction_years = 0\n",
    "number_of_infrastructure_processes = 0"
   ],
   "id": "4b54f6345793ef7f",
   "outputs": [],
   "execution_count": 6
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "The parametric model should now be set to include uncertainty for the MC loops. This is done below, by setting a number of parameters to raneg with some probability distributions",
   "id": "20061b8fc1dd6584"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.875704Z",
     "start_time": "2025-06-12T10:06:21.848393Z"
    }
   },
   "cell_type": "code",
   "source": [
    "BWR_capacity = np.random.normal(loc=1500, scale = 100, size = (scenarios, timeframe//time_step))\n",
    "PWR_capacity = np.random.uniform(low=700, high = 950, size = (scenarios, timeframe//time_step))\n",
    "\n",
    "NG_ccpp_capacity = np.random.normal(loc=400, scale = 10, size = (scenarios, timeframe//time_step))\n",
    "NG_cogen_conv_capacity = NG_ccpp_capacity * np.random.uniform(low=0.1, high=0.1, size = (scenarios, timeframe//time_step))\n",
    "NG_convpp_capacity = np.random.normal(loc=1100, scale = 175, size = (scenarios, timeframe//time_step))\n",
    "NG_cogen_cc_capacity = np.random.normal(loc=230, scale = 10, size = (scenarios, timeframe//time_step))\n",
    "\n",
    "Hydro_pumped_capacity = np.random.normal(loc=420, scale = 42, size = (scenarios, timeframe//time_step))\n",
    "DGE_capacity = np.random.normal(loc=85, scale = 10, size = (scenarios, timeframe//time_step))\n",
    "Wind_1_3_capacity = np.random.normal(loc= 980, scale = 100, size = (scenarios, timeframe//time_step))"
   ],
   "id": "75f9f7c7a6da80e1",
   "outputs": [],
   "execution_count": 7
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.922873Z",
     "start_time": "2025-06-12T10:06:21.910426Z"
    }
   },
   "cell_type": "code",
   "source": [
    "nuclear_capacity = BWR_capacity + PWR_capacity\n",
    "ng_capacity = NG_ccpp_capacity + NG_convpp_capacity + NG_cogen_conv_capacity + NG_cogen_cc_capacity\n",
    "res_capacity = Hydro_pumped_capacity + DGE_capacity + Wind_1_3_capacity"
   ],
   "id": "417b4a32b216b7bc",
   "outputs": [],
   "execution_count": 8
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:21.971386Z",
     "start_time": "2025-06-12T10:06:21.958341Z"
    }
   },
   "cell_type": "code",
   "source": "total_capacity = nuclear_capacity + ng_capacity + res_capacity",
   "id": "36b83a92a0ecc4b0",
   "outputs": [],
   "execution_count": 9
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": [
    "# Example:\n",
    "We consider three sub_processes: Nuclear power generation, RES power generation, and fossil power generation (only natural gas)\n",
    "\n",
    "We navigate in the activity browser or brightway in the project defined in the brightway_configuration_dictionary above, and we derive the\n",
    "keys that point to activities representing nuclear power generation from boiling or pressure water reactors, natural gas power generation from conventional or combined\n",
    "cycle plants for standalone and co-generation plants, hydro power generation from pumped storage, deep geothermal power generation, onshore wind power generation.\n",
    "We consider the UK as our geographical reference.\n",
    "\n",
    "We are using ecoinvent processes `as is'. Nevertheless, one could create their own processes and assign their own keys to them."
   ],
   "id": "7e5079a1844bbf8e"
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": [
    "The definition of the sub-processes and main process is the same as in the simple LCA, but now the lists holding the exchanges hold numpy arrays of dimensions\n",
    "(scenarios, timeframe//time_step)."
   ],
   "id": "64a9f1574da2d493"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:22.018807Z",
     "start_time": "2025-06-12T10:06:22.005041Z"
    }
   },
   "cell_type": "code",
   "source": [
    "keys_nuclear_power_generation = {\n",
    "'PWR' :  'bw_key_pointing_to_relevant_process',\n",
    "'BWR' : 'bw_key_pointing_to_relevant_process'\n",
    "}\n",
    "nuclear_exchanges_amounts = [\n",
    "PWR_capacity/nuclear_capacity,\n",
    "BWR_capacity/nuclear_capacity\n",
    "]\n",
    "\n",
    "keys_fossil_power_generation = {\n",
    "'NG_ccpp' :  'bw_key_pointing_to_relevant_process',\n",
    "'NG_convpp' : 'bw_key_pointing_to_relevant_process',\n",
    "'NG_cogen_conv' :  'bw_key_pointing_to_relevant_process',\n",
    "'NG_cogen_cc' : 'bw_key_pointing_to_relevant_process',\n",
    "}\n",
    "fossil_exchanges_amounts = [\n",
    "NG_ccpp_capacity/ng_capacity,\n",
    "NG_convpp_capacity/ng_capacity,\n",
    "NG_cogen_conv_capacity/ng_capacity,\n",
    "NG_cogen_cc_capacity/ng_capacity,\n",
    "]\n",
    "\n",
    "keys_res_power_generation = {\n",
    "'Hydro' :  'bw_key_pointing_to_relevant_process',\n",
    "'DGE' : 'bw_key_pointing_to_relevant_process',\n",
    "'Wind' :  'bw_key_pointing_to_relevant_process',\n",
    "}\n",
    "res_exchanges_amounts = [\n",
    "Hydro_pumped_capacity/res_capacity,\n",
    "DGE_capacity/res_capacity,\n",
    "Wind_1_3_capacity/res_capacity,\n",
    "]"
   ],
   "id": "320a56a2fb1a61c9",
   "outputs": [],
   "execution_count": 10
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "And here we set the dictionaries for the main process",
   "id": "d09aac7800bc3088"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-06-12T10:06:22.097218Z",
     "start_time": "2025-06-12T10:06:22.083479Z"
    }
   },
   "cell_type": "code",
   "source": [
    "keys_total_power_generation = {\n",
    "'Nuclear': '',\n",
    "'Fossil' : '',\n",
    "'RES' : '',\n",
    "}\n",
    "\n",
    "mp_exchanges_amounts = [\n",
    "nuclear_capacity/total_capacity,\n",
    "ng_capacity/total_capacity,\n",
    "res_capacity/total_capacity,\n",
    "]"
   ],
   "id": "1b9012e966c9ccde",
   "outputs": [],
   "execution_count": 11
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "The main preparation follows the example for the simple LCA. However in this case the exchanges are not scalars but numpy arrays of dimensions (scenarios, 1)",
