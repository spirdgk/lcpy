    }
   },
   "cell_type": "code",
   "source": [
    "key_previously_main_process = {\n",
    "    'Electricity production': ''\n",
    "}\n",
    "exchange_list_previously_main_process = [\n",
    "    30*np.ones((scenarios, timeframe//time_step))/functional_unit\n",
    "]"
   ],
