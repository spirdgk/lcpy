    }
   },
   "cell_type": "code",
   "source": [
    "key_list_sub_processes = [keys_nuclear_power_generation, keys_fossil_power_generation, keys_res_power_generation]\n",
    "exchanges_list_sub_processes = [nuclear_exchanges_amounts, fossil_exchanges_amounts, res_exchanges_amounts]"
   ],
